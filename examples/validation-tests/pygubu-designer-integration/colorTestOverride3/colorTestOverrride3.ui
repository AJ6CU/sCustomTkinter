<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">colorTestOverride3</setting>
      <setting id="description">colorTestOverride3</setting>
      <setting id="template">codescript</setting>
      <setting id="main_widget">sctk1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">colorTestOverride3</setting>
      <setting id="main_classname">colorTestOverride3</setting>
      <setting id="output_dir">.</setting>
