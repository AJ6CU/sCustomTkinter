<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">testdialog</setting>
      <setting id="description">testdialog</setting>
      <setting id="template">codescript</setting>
      <setting id="main_widget">sctkdialog1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">testdialog</setting>
      <setting id="main_classname">testdialog</setting>
      <setting id="output_dir">.</setting>
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="scustomtkinter.sCTkDialog" id="sctkdialog1">
    <property name="apply_command" type="command" cbtype="simple">apply_cb</property>
    <property name="buttons">3</property>
    <property name="cancel_command" type="command" cbtype="simple">cancel_cb</property>
    <property name="cancel_text">Cancel</property>
    <property name="heading">Maybe a Settings Dialog?</property>
    <property name="heading_anchor">center</property>
    <property name="reset_command" type="command" cbtype="simple">reset_cb</property>
    <property name="reset_text">Whatever</property>
    <property name="title" translatable="yes">Your Window Title</property>
    <property name="transient">False</property>
    <layout manager="grid">
      <property name="column">0</property>
      <property name="row">0</property>
    </layout>
    <child>
      <object class="scustomtkinter.sCTkFrame" id="sctkframe1">
        <property name="border_width">2</property>
        <layout manager="pack">
          <property name="expand">false</property>
          <property name="ipadx">5</property>
          <property name="ipady">5</property>
          <property name="padx">10</property>
          <property name="pady">10</property>
          <property name="side">top</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkLabelPrimary" id="sctklabelprimary2">
            <property name="text" translatable="yes">Your widgets here</property>
            <layout manager="pack">
              <property name="pady">5</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkLabelSecondary" id="sctklabelsecondary1">
            <property name="text" translatable="yes">Secondary Label</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkButtonSecondary" id="sctkbuttonsecondary1">
            <property name="text" translatable="yes">A Button</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
