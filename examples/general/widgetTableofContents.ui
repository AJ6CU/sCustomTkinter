<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">testColorOverride4</setting>
      <setting id="description">testColorOverride4</setting>
      <setting id="template">codescript</setting>
      <setting id="main_widget">sctk1</setting>
      <setting id="module_namespace" />
      <setting id="module_name">testColorOverride4</setting>
      <setting id="main_classname">testColorOverride4</setting>
      <setting id="output_dir">.</setting>
      <setting id="builder_namespace">custom_widgets</setting>
      <setting id="output_dir2" />
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="scustomtkinter.sCTk" id="sctk1">
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary1">
        <property name="label_text">Button Options
</property>
        <layout manager="grid">
          <property name="column">0</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkButtonPrimary" id="sctkbuttonprimary1">
            <property name="text" translatable="yes">Primary</property>
            <layout manager="pack">
              <property name="pady">0 10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkButtonSecondary" id="sctkbuttonsecondary1">
            <property name="text" translatable="yes">Secondary</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkButtonTertiary" id="sctkbuttontertiary1">
            <property name="text" translatable="yes">Ghost	</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkSegmentedButton" id="sctksegmentedbutton2">
            <property name="unselected_color">gray</property>
            <property name="values">["one","two", "three"]</property>
            <layout manager="pack">
              <property name="pady">10 0</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary2">
        <property name="label_text">Labels Options
</property>
        <layout manager="grid">
          <property name="column">1</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkLabelPrimary" id="sctklabelprimary1">
            <property name="text" translatable="yes">Primary</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkLabelSecondary" id="sctklabelsecondary1">
            <property name="text" translatable="yes">Secondary</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkLabelTertiary" id="sctklabeltertiary1">
            <property name="text" translatable="yes">Tertiary</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary9">
        <property name="label_text">Data Entry</property>
        <layout manager="grid">
          <property name="column">2</property>
          <property name="row">0</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkEntryPrimary" id="sctkentryprimary1">
            <property name="text" translatable="yes">Entry Box Primary</property>
            <layout manager="pack">
              <property name="pady">20</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkEntrySecondary" id="sctkentrysecondary1">
            <property name="text" translatable="yes">Entry Box Secondary</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary4">
        <property name="label_text">Menus</property>
        <layout manager="grid">
          <property name="row">1</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkComboBox" id="sctkcombobox1">
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkOptionMenuPrimary" id="sctkoptionmenuprimary1">
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkOptionMenuSecondary" id="sctkoptionmenusecondary1">
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkSpinbox" id="sctkspinbox1">
            <property name="values">["spinbox"]</property>
            <layout manager="pack">
              <property name="pady">10 0</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary5">
        <property name="label_text">More Buttons</property>
        <layout manager="grid">
          <property name="column">1</property>
          <property name="row">1</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkCheckBox" id="sctkcheckbox1">
            <property name="text" translatable="yes">Checkbox</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkRadioButton" id="sctkradiobutton1">
            <property name="text" translatable="yes">RadioButton</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkSwitch" id="sctkswitch1">
            <property name="text" translatable="yes">Switch</property>
            <layout manager="pack">
              <property name="pady">10</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary6">
        <property name="label_text">Text Boxes</property>
        <layout manager="grid">
          <property name="column">2</property>
          <property name="row">1</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkTextboxPrimary" id="sctktextboxprimary1">
            <property name="border_color">blue</property>
            <property name="height">100</property>
            <property name="text" translatable="yes">Primary Textboxes</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkTextboxSecondary" id="sctktextboxsecondary1">
            <property name="border_color">yellow</property>
            <property name="border_width">1</property>
            <property name="height">75</property>
            <property name="text" translatable="yes">Secondary Textboxes</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary7">
        <property name="label_text">Single or Multi Selector</property>
        <layout manager="grid">
          <property name="row">2</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkSelector" id="sctkselector1">
            <property name="items">["VW","Porsche","240Z"]</property>
            <layout manager="pack">
              <property name="expand">false</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkFrameLabeledPrimary" id="sctkframelabeledprimary3">
        <property name="label_text">Slider,Separator, Progress</property>
        <layout manager="grid">
          <property name="column">1</property>
          <property name="row">2</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkLabelTertiary" id="sctklabeltertiary3">
            <property name="text" translatable="yes">slider</property>
            <layout manager="pack">
              <property name="pady">10 0</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkSlider" id="sctkslider1">
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkSeparator" id="sctkseparator1">
            <property name="length">300</property>
            <property name="orientation">horizontal</property>
            <property name="text" translatable="yes">Separator</property>
            <layout manager="pack">
              <property name="ipady">10</property>
              <property name="pady">20</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkLabelTertiary" id="sctklabeltertiary2">
            <property name="text" translatable="yes">Progress Bar</property>
            <layout manager="pack">
              <property name="pady">10 0</property>
              <property name="side">top</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="scustomtkinter.sCTkProgressBar" id="sctkprogressbar1">
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="scustomtkinter.sCTkScrollableFrame" id="sctkscrollableframe1">
        <property name="label_text">scrollable frame</property>
        <layout manager="grid">
          <property name="column">2</property>
          <property name="row">2</property>
        </layout>
        <child>
          <object class="scustomtkinter.sCTkLabelTertiary" id="sctklabeltertiary4">
            <property name="text" translatable="yes">stuff can scroll x or y</property>
            <layout manager="pack">
              <property name="side">top</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
